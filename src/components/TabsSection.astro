---
import Icon from './Icon.astro'
import FestiveIcon from './FestiveIcon.astro'
import { TABS, PRODUCTS, MISSION, TEAM, EMAIL, DISCORD_URL } from '../data/site'
---

<section id="paneles" class="relative scroll-mt-24 px-4 pt-16 sm:px-6 sm:pt-20">
  <div class="mx-auto max-w-7xl">
    <!-- Cabecera -->
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="reveal flex items-center gap-2 font-display text-sm font-semibold text-flame-400">
          Explora
          <FestiveIcon name="holly" class="festive h-4 w-4 festive-accent-alt" />
        </p>
        <h2
          class="reveal title-balance mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-[2.6rem]"
          style="--reveal-delay:60ms"
          id="paneles-title"
        >
          Nuestros productos
        </h2>
        <p
          class="reveal mt-3 max-w-xl text-base leading-relaxed text-mist-400"
          style="--reveal-delay:120ms"
          id="paneles-desc"
        >
          Herramientas construidas para lo que la gente usa de verdad. Desde República Dominicana.
        </p>
      </div>

      <p class="reveal hidden items-center gap-2 text-sm text-mist-500 lg:flex" style="--reveal-delay:160ms">
        <kbd class="rounded-md border border-white/12 bg-white/5 px-2 py-1 font-sans text-xs text-mist-300">&larr;</kbd>
        <kbd class="rounded-md border border-white/12 bg-white/5 px-2 py-1 font-sans text-xs text-mist-300">&rarr;</kbd>
        para moverte entre pestañas
      </p>
    </div>

    <!-- Barra de pestañas -->
    <div class="glass reveal mt-8 !rounded-[20px] p-0" style="--reveal-delay:200ms">
      <div class="tablist" role="tablist" aria-label="Secciones de TryFlama" id="main-tablist">
        <span class="tab-indicator" id="tab-indicator" aria-hidden="true"></span>
        {
          TABS.map((tab, i) => (
            <button
              type="button"
              class="tab"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={tab.id}
              data-title={tab.title}
              data-desc={tab.desc}
            >
              <Icon name={tab.icon} class="h-4 w-4 shrink-0" />
              <span class="tab__label">{tab.label}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-6">
      <!-- PANEL: PRODUCTOS -->
      <div class="tabpanel" role="tabpanel" id="panel-productos" aria-labelledby="tab-productos" tabindex="0">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            PRODUCTS.map((p, i) =>
              p.link ? (
                <a
                  href={p.link}
                  target="_blank"
                  rel="noopener"
                  class="tile group flex flex-col"
                  style={`--reveal-delay:${i * 50}ms`}
                >
                  <div class="flex items-start justify-between gap-3">
                    <span class="tile-icon">
                      <Icon name={p.icon} class="h-5 w-5" />
                    </span>
                    <span class="grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-white/5 text-mist-400 transition-colors group-hover:border-flame-300/40 group-hover:text-flame-300">
                      <Icon name="external" class="h-3.5 w-3.5" />
                    </span>
                  </div>

                  <h3 class="mt-5 font-display text-lg font-bold text-white">{p.name}</h3>
                  <p class="mt-1 truncate text-xs font-semibold text-flame-400">
                    {p.link.replace('https://', '')}
                  </p>

                  <p class="mt-3 flex-1 text-sm leading-relaxed text-mist-400">{p.desc}</p>

                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {p.features.map((f) => (
                      <li class="rounded-full border border-white/10 bg-white/4 px-2.5 py-1 text-[11px] font-medium text-mist-300">
                        {f}
                      </li>
                    ))}
                  </ul>
                </a>
              ) : (
                <article
                  class="tile tile--featured flex flex-col"
                  style={`--reveal-delay:${i * 50}ms`}
                >
                  <div class="flex items-start justify-between gap-3">
                    <span class="tile-icon">
                      <Icon name={p.icon} class="h-5 w-5" />
                    </span>
                    <p class="mt-1 inline-flex items-center gap-1.5 rounded-full border border-flame-400/30 bg-flame-500/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-flame-200">
                      <FestiveIcon name="gift" class="festive h-3 w-3" />
                      Próximamente
                    </p>
                  </div>

                  <h3 class="mt-5 font-display text-lg font-bold text-white">{p.name}</h3>

                  <p class="mt-3 flex-1 text-sm leading-relaxed text-mist-400">{p.desc}</p>

                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {p.features.map((f) => (
                      <li class="rounded-full border border-white/10 bg-white/4 px-2.5 py-1 text-[11px] font-medium text-mist-300">
                        {f}
                      </li>
                    ))}
                  </ul>
                </article>
              )
            )
          }
        </div>

        <div class="glass-soft mt-4 flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center">
          <p class="text-sm leading-relaxed text-mist-300">
            Todo es gratis y sin límites artificiales. Usa la API, invita a Anna a tu servidor y cuéntanos qué falta.
          </p>
          <a href="#contacto" class="btn-flame shrink-0 !px-5 !py-2.5 !text-sm" data-open-tab="contacto">
            Hablemos
          </a>
        </div>
      </div>

      <!-- PANEL: MISIÓN -->
      <div class="tabpanel" role="tabpanel" id="panel-mision" aria-labelledby="tab-mision" tabindex="0" hidden>
        <div class="glass p-6 sm:p-8">
          <h3 class="font-display text-2xl font-bold text-white">{MISSION.title}</h3>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-300">{MISSION.desc}</p>

          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {
              MISSION.values.map((v) => (
                <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <span class="tile-icon">
                    <Icon name={v.icon} class="h-5 w-5" />
                  </span>
                  <h4 class="mt-3 font-display font-bold text-white">{v.title}</h4>
                  <p class="mt-1 text-sm text-mist-400">{v.desc}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- PANEL: EQUIPO -->
      <div class="tabpanel" role="tabpanel" id="panel-equipo" aria-labelledby="tab-equipo" tabindex="0" hidden>
        <div class="glass p-6 sm:p-8">
          <h3 class="font-display text-2xl font-bold text-white">Hacemos esto juntos</h3>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-300">
            TryFlama no es solo un equipo: somos una comunidad. Cada persona que usa nuestros productos, reporta bugs, sugiere mejoras o contribuye, forma parte de nosotros.
          </p>

          <div class="mt-8 space-y-4">
            {
              TEAM.map((t) => (
                <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-4">
                  <span class="tile-icon shrink-0">
                    <Icon name={t.icon} class="h-5 w-5" />
                  </span>
                  <div>
                    <p class="font-display font-bold text-white">{t.title}</p>
                    <p class="mt-1 text-sm text-mist-400">{t.desc}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <p class="mt-8 text-sm text-mist-500">
            ¿Quieres contribuir? Únete al Discord: abiertos a ideas, pull requests y feedback.
          </p>
        </div>
      </div>

      <!-- PANEL: CONTACTO -->
      <div class="tabpanel" role="tabpanel" id="panel-contacto" aria-labelledby="tab-contacto" tabindex="0" hidden>
        <div class="glass relative overflow-hidden p-7 sm:p-12">
          <div class="pointer-events-none absolute -top-24 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-flame-500/25 blur-[90px]" aria-hidden="true"></div>

          <div class="relative mx-auto max-w-2xl text-center">
            <h3 class="title-balance font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Contáctanos
            </h3>
            <p class="mt-3 text-base leading-relaxed text-mist-300">
              ¿Tienes un proyecto en mente o quieres usar nuestros productos? Escríbenos y te respondemos.
            </p>
            <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
              <a href={`mailto:${EMAIL}`} class="btn-flame">
                <Icon name="mail" class="h-4 w-4" />
                Escríbenos
              </a>
              <a href={DISCORD_URL} target="_blank" rel="noopener" class="btn-glass">
                <Icon name="discord" class="h-4 w-4 text-flame-300" />
                Discord
                <span class="sr-only">(se abre en otra pestaña)</span>
              </a>
            </div>
          </div>

          <div class="relative mt-9 grid gap-3 sm:grid-cols-2">
            <a href={`mailto:${EMAIL}`} class="glass-soft group flex items-center gap-4 p-5 transition hover:border-flame-400/40">
              <span class="tile-icon shrink-0">
                <Icon name="mail" class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-display text-sm font-bold text-white">Email</span>
                <span class="mt-0.5 block truncate text-sm text-mist-400">{EMAIL}</span>
              </span>
            </a>

            <a href={DISCORD_URL} target="_blank" rel="noopener" class="glass-soft group flex items-center gap-4 p-5 transition hover:border-flame-400/40">
              <span class="tile-icon shrink-0">
                <Icon name="discord" class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-display text-sm font-bold text-white">Discord</span>
                <span class="mt-0.5 block truncate text-sm text-mist-400">Comunidad abierta</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tablist = document.getElementById('main-tablist') as HTMLElement | null
  const indicator = document.getElementById('tab-indicator') as HTMLElement | null
  const titleEl = document.getElementById('paneles-title')
  const descEl = document.getElementById('paneles-desc')

  if (tablist && indicator) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs.map(
      (t) => document.getElementById(t.getAttribute('aria-controls')!)!
    )
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const moveIndicator = () => {
      const selected = tabs.find((t) => t.getAttribute('aria-selected') === 'true')
      if (!selected) return
      indicator.style.width = `${selected.offsetWidth}px`
      indicator.style.transform = `translateX(${selected.offsetLeft}px)`
    }

    const setHeading = (tab: HTMLButtonElement) => {
      if (titleEl && tab.dataset.title) titleEl.textContent = tab.dataset.title
      if (descEl && tab.dataset.desc) descEl.textContent = tab.dataset.desc
    }

    const activate = (
      id: string,
      opts: { focus?: boolean; updateUrl?: boolean; scroll?: boolean }
    ) => {
      const { focus = false, updateUrl = true, scroll = false } = opts ?? {}
      const index = tabs.findIndex((t) => t.dataset.tab === id)
      if (index === -1) return

      tabs.forEach((t, i) => {
        const isSelected = i === index
        t.setAttribute('aria-selected', String(isSelected))
        t.tabIndex = isSelected ? 0 : -1
      })

      panels.forEach((p, i) => {
        p.hidden = i !== index
      })

      /* Los bloques con revelado del panel activo se muestran ya */
      panels[index]
        ?.querySelectorAll<HTMLElement>('.reveal')
        .forEach((el) => el.classList.add('is-visible'))

      setHeading(tabs[index])
      moveIndicator()

      if (focus) tabs[index].focus({ preventScroll: true })

      if (updateUrl) {
        const target = `#${id}`
        if (window.location.hash !== target) history.replaceState(null, '', target)
      }

      if (scroll) {
        document
          .getElementById('paneles')
          ?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' })
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.dataset.tab!, { focus: true }))
    })

    /* Teclado: flechas, Home, End */
    tablist.addEventListener('keydown', (e) => {
      const idx = tabs.indexOf(document.activeElement as HTMLButtonElement)
      if (idx === -1) return

      const last = tabs.length - 1
      let next: number | null = null

      if (e.key === 'ArrowRight') next = idx === last ? 0 : idx + 1
      else if (e.key === 'ArrowLeft') next = idx === 0 ? last : idx - 1
      else if (e.key === 'Home') next = 0
      else if (e.key === 'End') next = last

      if (next !== null) {
        e.preventDefault()
        activate(tabs[next].dataset.tab!, { focus: true })
      }
    })

    /* CTAs que abren una pestaña concreta */
    document.querySelectorAll<HTMLElement>('[data-open-tab]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault()
        const id = el.dataset.openTab!
        if (el.closest('#mobile-menu')) document.getElementById('menu-btn')?.click()
        activate(id, { updateUrl: true, scroll: true })
      })
    })

    /* Estado inicial desde la URL */
    const initial = window.location.hash.replace('#', '')
    if (initial && tabs.some((t) => t.dataset.tab === initial)) {
      activate(initial, { updateUrl: false })
    } else {
      activate(tabs[0].dataset.tab!, { updateUrl: false })
    }

    window.addEventListener('hashchange', () => {
      const id = window.location.hash.replace('#', '')
      if (tabs.some((t) => t.dataset.tab === id)) activate(id, { updateUrl: false })
    })

    window.addEventListener('resize', moveIndicator, { passive: true })
    document.fonts?.ready.then(moveIndicator)
    requestAnimationFrame(moveIndicator)
  }
</script>