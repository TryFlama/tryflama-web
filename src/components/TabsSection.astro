---
import Icon from './Icon.astro'
import ChristmasIcon from './ChristmasIcon.astro'
import { TABS, PRODUCTS, MISSION, TEAM, EMAIL, DISCORD_URL, COUNTRY } from '../data/site'

interface Props {
  reviews: any[]
  rating: number
  reviewCount: number
}

const { reviews, rating, reviewCount } = Astro.props

const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? '')
    .join('')
---

<section id="paneles" class="relative scroll-mt-24 px-4 pt-16 sm:px-6 sm:pt-20">
  <div class="mx-auto max-w-7xl">
    <!-- Cabecera -->
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="reveal font-display text-sm font-semibold text-flame-400">
          <ChristmasIcon name="tree" class="inline-block h-4 w-4 align-middle" /> Especial Navidad 2026
        </p>
        <h2 class="reveal title-balance mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-[2.6rem]" style="--reveal-delay:60ms">
          Herramientas hechas para la gente
        </h2>
        <p class="reveal mt-3 max-w-xl text-base leading-relaxed text-mist-400" style="--reveal-delay:120ms">
          Creamos webs, apps y soluciones digitales desde {COUNTRY}. Sin fines de lucro, sin limitaciones. Solo herramientas que funcionan.
        </p>
      </div>
    </div>

    <!-- Barra de pestañas -->
    <div class="glass reveal mt-8 !rounded-[20px] p-0" style="--reveal-delay:200ms">
      <div class="tablist" role="tablist" aria-label="Secciones de TryFlama" id="main-tablist">
        <span class="tab-indicator" id="tab-indicator" aria-hidden="true"></span>
        {
          TABS.map((tab, i) => (
            <button
              type="button"
              class="tab"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={tab.id}
            >
              <Icon name={tab.icon} class="h-4 w-4" />
              <span class="hidden sm:inline">{tab.label}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-6">
      <!-- PANEL: PRODUCTOS -->
      <div class="tabpanel" role="tabpanel" id="panel-productos" aria-labelledby="tab-productos" tabindex="0">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            PRODUCTS.map((p, i) => (
              <a
                href={p.link || '#'}
                target={p.link?.includes('http') ? '_blank' : undefined}
                rel={p.link?.includes('http') ? 'noopener' : undefined}
                class="tile group block"
                style={`--reveal-delay:${i * 50}ms`}
              >
                <span class="tile-icon">
                  <Icon name={p.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-4 font-display text-lg font-bold text-white">{p.name}</h3>
                {p.comingSoon && (
                  <p class="mt-1 flex items-center gap-1 text-xs font-bold text-flame-400">
                    <ChristmasIcon name="gift" class="h-3.5 w-3.5" /> Próximamente
                  </p>
                )}
                <p class="mt-2 text-sm leading-relaxed text-mist-400">{p.desc}</p>
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {p.features.map((f) => (
                    <li class="rounded-full border border-white/10 bg-white/4 px-2.5 py-1 text-[11px] font-medium text-mist-300">
                      {f}
                    </li>
                  ))}
                </ul>
              </a>
            ))
          }
        </div>
      </div>

      <!-- PANEL: MISIÓN -->
      <div class="tabpanel" role="tabpanel" id="panel-mision" aria-labelledby="tab-mision" tabindex="0" hidden>
        <div class="glass reveal p-6 sm:p-8">
          <h3 class="font-display text-2xl font-bold text-white">{MISSION.title}</h3>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-300">{MISSION.desc}</p>

          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {
              MISSION.values.map((v) => (
                <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <p class="text-2xl">{v.emoji}</p>
                  <h4 class="mt-3 font-display font-bold text-white">{v.title}</h4>
                  <p class="mt-1 text-sm text-mist-400">{v.desc}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- PANEL: EQUIPO -->
      <div class="tabpanel" role="tabpanel" id="panel-equipo" aria-labelledby="tab-equipo" tabindex="0" hidden>
        <div class="glass reveal p-6 sm:p-8">
          <h3 class="font-display text-2xl font-bold text-white">Hacemos esto juntos</h3>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-300">
            TryFlama no es solo un equipo: somos una comunidad. Cada persona que usa nuestros productos, reporta bugs, sugiere features o contribuye es parte de nosotros.
          </p>

          <div class="mt-8 space-y-4">
            {
              TEAM.map((m) => (
                <div class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-4">
                  <span class="text-3xl">{m.emoji}</span>
                  <div>
                    <p class="font-display font-bold text-white">{m.name}</p>
                    <p class="mt-1 text-sm text-mist-400">{m.role}</p>
                  </div>
                </div>
              ))
            }
          </div>

          <p class="mt-8 text-center text-sm text-mist-500">
            ¿Quieres contribuir? Únete a nuestro Discord → somos abiertos a ideas, pullrequests y feedback.
          </p>
        </div>
      </div>

      <!-- PANEL: CONTACTO / ÚNETE -->
      <div class="tabpanel" role="tabpanel" id="panel-contacto" aria-labelledby="tab-contacto" tabindex="0" hidden>
        <div class="glass relative overflow-hidden p-7 sm:p-12">
          <div class="pointer-events-none absolute -top-24 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-flame-500/25 blur-[90px]" aria-hidden="true"></div>

          <div class="relative mx-auto max-w-2xl text-center">
            <h3 class="title-balance font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
              <ChristmasIcon name="tree" class="inline-block h-8 w-8 sm:h-10 sm:w-10 align-middle" /> Únete a nosotros
            </h3>
            <p class="mt-3 text-base leading-relaxed text-mist-300">
              Somos una comunidad abierta. Usa nuestros productos, reporta bugs, sugiere features o únete a Discord para contribuir.
            </p>
            <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
              <a href={`mailto:${EMAIL}`} class="btn-flame">
                <Icon name="mail" class="h-4 w-4" />
                Escríbenos
              </a>
              <a href={DISCORD_URL} target="_blank" rel="noopener" class="btn-glass">
                <Icon name="discord" class="h-4 w-4 text-flame-300" />
                Discord
              </a>
            </div>
          </div>

          <div class="relative mt-9 grid gap-3 sm:grid-cols-2">
            <a href={`mailto:${EMAIL}`} class="glass-soft group flex items-center gap-4 p-5 transition hover:border-flame-400/40">
              <span class="tile-icon shrink-0">
                <Icon name="mail" class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-display text-sm font-bold text-white">Email</span>
                <span class="mt-0.5 block truncate text-sm text-mist-400">{EMAIL}</span>
              </span>
            </a>

            <a href={DISCORD_URL} target="_blank" rel="noopener" class="glass-soft group flex items-center gap-4 p-5 transition hover:border-flame-400/40">
              <span class="tile-icon shrink-0">
                <Icon name="discord" class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-display text-sm font-bold text-white">Discord</span>
                <span class="mt-0.5 block truncate text-sm text-mist-400">Comunidad abierta</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ TABS }}>
  // Nieve navideña con iconos SVG personalizados
  const createSnowflakes = () => {
    if (Math.random() > 0.4) return;
    const flake = document.createElement('div');
    flake.className = 'snowflake';
    
    // Crear SVG inline para cada copo
    const svgTypes = [
      // Snowflake
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><path d="M12 2v20M2 12h20M6 6l12 12M18 6L6 18" stroke="#E0F2FE" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="2" r="1" fill="#E0F2FE"/><circle cx="12" cy="22" r="1" fill="#E0F2FE"/><circle cx="2" cy="12" r="1" fill="#E0F2FE"/><circle cx="22" cy="12" r="1" fill="#E0F2FE"/></svg>',
      // Star
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><path d="M12 2l2.5 7.5H22l-6 4.5 2.5 7.5L12 17l-6.5 4.5L8 14 2 9.5h7.5z" fill="#FFD700" stroke="#FFD700" stroke-width="1.2" stroke-linejoin="round"/></svg>',
      // Sparkle
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><path d="M12 2v6m0 8v6M2 12h6m8 0h6" stroke="#FFD700" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="12" r="2" fill="#FFD700"/></svg>',
      // Gift
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%"><rect x="4" y="10" width="16" height="12" rx="1" fill="#FF5C72" stroke="#FF8296" stroke-width="1.5"/><rect x="4" y="6" width="16" height="4" rx="0.5" fill="#FF8296" stroke="#FF8296" stroke-width="1.5"/><path d="M12 6v16" stroke="#FFD700" stroke-width="2"/></svg>',
    ];
    
    flake.innerHTML = svgTypes[Math.floor(Math.random() * svgTypes.length)];
    const duration = 6 + Math.random() * 6;
    const left = Math.random() * 100;
    const tx = (Math.random() - 0.5) * 150;
    flake.style.setProperty('--tx', tx + 'px');
    flake.style.left = left + '%';
    flake.style.animationDuration = duration + 's';
    document.body.appendChild(flake);
    setTimeout(() => flake.remove(), duration * 1000);
  };
  
  setInterval(createSnowflakes, 300);

  // Tabs
  const tablist = document.getElementById('main-tablist');
  const indicator = document.getElementById('tab-indicator');
  if (tablist && indicator) {
    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')));
    
    const moveIndicator = () => {
      const selected = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (!selected) return;
      indicator.style.width = selected.offsetWidth + 'px';
      indicator.style.transform = 'translateX(' + selected.offsetLeft + 'px)';
    };

    const activate = (id, options) => {
      const opts = options || {};
      const focus = opts.focus || false;
      const updateUrl = opts.updateUrl !== false;
      const index = tabs.findIndex((t) => t.dataset.tab === id);
      if (index === -1) return;
      
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === index));
        t.tabIndex = i === index ? 0 : -1;
      });
      
      panels.forEach((p, i) => {
        if (p) p.hidden = i !== index;
      });
      
      const activePanel = panels[index];
      if (activePanel) {
        activePanel.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
      }
      
      moveIndicator();
      if (focus) tabs[index].focus({ preventScroll: true });
      if (updateUrl) history.replaceState(null, '', '#' + id);
    };

    tabs.forEach((t) => t.addEventListener('click', () => activate(t.dataset.tab, { focus: true })));
    
    tablist.addEventListener('keydown', (e) => {
      const idx = tabs.indexOf(document.activeElement);
      if (idx === -1) return;
      const last = tabs.length - 1;
      let next = null;
      if (e.key === 'ArrowRight') next = idx === last ? 0 : idx + 1;
      else if (e.key === 'ArrowLeft') next = idx === 0 ? last : idx - 1;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = last;
      if (next !== null) {
        e.preventDefault();
        activate(tabs[next].dataset.tab, { focus: true });
      }
    });

    document.querySelectorAll('[data-open-tab]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        activate(el.dataset.openTab, { updateUrl: true });
      });
    });

    const initial = window.location.hash.replace('#', '');
    if (initial && tabs.some((t) => t.dataset.tab === initial)) {
      activate(initial, { updateUrl: false });
    } else {
      activate(tabs[0].dataset.tab, { updateUrl: false });
    }

    window.addEventListener('hashchange', () => {
      const id = window.location.hash.replace('#', '');
      if (tabs.some((t) => t.dataset.tab === id)) activate(id, { updateUrl: false });
    });
    
    window.addEventListener('resize', moveIndicator, { passive: true });
    if (document.fonts) {
      document.fonts.ready.then(moveIndicator);
    }
    requestAnimationFrame(moveIndicator);
  }
</script>
