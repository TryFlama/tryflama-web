---
interface Props {
  name: 'tree' | 'snowflake' | 'gift' | 'star' | 'sparkle' | 'rd-flag'
  class?: string
}

const { name, class: className = '' } = Astro.props
---

{name === 'tree' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2L8 8h2l-3 6h2l-3 6h12l-3-6h2l-3-6h2z" fill="url(#tree-grad)" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <rect x="10" y="20" width="4" height="2" rx="0.5" fill="#8B7355"/>
    <circle cx="12" cy="10" r="0.8" fill="#FFD700"/>
    <circle cx="10" cy="13" r="0.8" fill="#FF5C72"/>
    <circle cx="14" cy="15" r="0.8" fill="#FFD700"/>
    <defs>
      <linearGradient id="tree-grad" x1="12" y1="2" x2="12" y2="20" gradientUnits="userSpaceOnUse">
        <stop stop-color="#16a34a"/>
        <stop offset="1" stop-color="#14532d"/>
      </linearGradient>
    </defs>
  </svg>
)}

{name === 'snowflake' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2v20M2 12h20M6 6l12 12M18 6L6 18" stroke="url(#snow-grad)" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="12" cy="2" r="1" fill="#E0F2FE"/>
    <circle cx="12" cy="22" r="1" fill="#E0F2FE"/>
    <circle cx="2" cy="12" r="1" fill="#E0F2FE"/>
    <circle cx="22" cy="12" r="1" fill="#E0F2FE"/>
    <circle cx="6" cy="6" r="1" fill="#E0F2FE"/>
    <circle cx="18" cy="18" r="1" fill="#E0F2FE"/>
    <circle cx="18" cy="6" r="1" fill="#E0F2FE"/>
    <circle cx="6" cy="18" r="1" fill="#E0F2FE"/>
    <defs>
      <linearGradient id="snow-grad" x1="12" y1="2" x2="12" y2="22" gradientUnits="userSpaceOnUse">
        <stop stop-color="#E0F2FE"/>
        <stop offset="1" stop-color="#BAE6FD"/>
      </linearGradient>
    </defs>
  </svg>
)}

{name === 'gift' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="4" y="10" width="16" height="12" rx="1" fill="url(#gift-grad)" stroke="currentColor" stroke-width="1.5"/>
    <rect x="4" y="6" width="16" height="4" rx="0.5" fill="#FF8296" stroke="currentColor" stroke-width="1.5"/>
    <path d="M12 6v16" stroke="#FFD700" stroke-width="2"/>
    <path d="M4 10h16" stroke="#FFD700" stroke-width="1.5"/>
    <path d="M8 6c0-1.5 1-3 2.5-3S12 4 12 6M16 6c0-1.5-1-3-2.5-3S12 4 12 6" stroke="#FFD700" stroke-width="1.5" stroke-linecap="round"/>
    <defs>
      <linearGradient id="gift-grad" x1="12" y1="10" x2="12" y2="22" gradientUnits="userSpaceOnUse">
        <stop stop-color="#FF5C72"/>
        <stop offset="1" stop-color="#FF1E3C"/>
      </linearGradient>
    </defs>
  </svg>
)}

{name === 'star' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2l2.5 7.5H22l-6 4.5 2.5 7.5L12 17l-6.5 4.5L8 14 2 9.5h7.5z" fill="url(#star-grad)" stroke="#FFD700" stroke-width="1.2" stroke-linejoin="round"/>
    <defs>
      <linearGradient id="star-grad" x1="12" y1="2" x2="12" y2="21.5" gradientUnits="userSpaceOnUse">
        <stop stop-color="#FFD700"/>
        <stop offset="1" stop-color="#FFA500"/>
      </linearGradient>
    </defs>
  </svg>
)}

{name === 'sparkle' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2v6m0 8v6M2 12h6m8 0h6" stroke="url(#sparkle-grad)" stroke-width="2" stroke-linecap="round"/>
    <path d="M6 6l3 3m6 6l3 3M18 6l-3 3M9 15l-3 3" stroke="url(#sparkle-grad)" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="12" cy="12" r="2" fill="#FFD700"/>
    <defs>
      <radialGradient id="sparkle-grad" cx="12" cy="12" r="10" gradientUnits="userSpaceOnUse">
        <stop stop-color="#FFD700"/>
        <stop offset="1" stop-color="#FF8296"/>
      </radialGradient>
    </defs>
  </svg>
)}

{name === 'rd-flag' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="2" y="5" width="20" height="14" rx="1" fill="#002D62" stroke="currentColor" stroke-width="1"/>
    <rect x="2" y="5" width="20" height="7" fill="#002D62"/>
    <rect x="2" y="12" width="20" height="7" fill="#CE1126"/>
    <rect x="9" y="5" width="6" height="14" fill="white"/>
    <rect x="2" y="9.5" width="20" height="5" fill="white"/>
    <circle cx="12" cy="12" r="2" fill="#CE1126" stroke="white" stroke-width="0.5"/>
  </svg>
)}
