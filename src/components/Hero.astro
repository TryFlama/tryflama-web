---
import Icon from './Icon.astro'
import FestiveIcon from './FestiveIcon.astro'
import { STAT_LINE } from '../data/site'
---

<section id="inicio" class="relative overflow-hidden px-4 pb-10 pt-28 sm:px-6 sm:pt-36">
  <div class="mesh" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
    <!-- Columna de texto -->
    <div class="max-w-2xl">
      <p class="chip reveal">
        <FestiveIcon name="snowflake" class="festive h-3.5 w-3.5 text-flame-200" />
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-flame-400 opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-flame-400"></span>
        </span>
        Disponible para nuevos proyectos
      </p>

      <h1
        class="heat-type title-balance mt-6 font-display text-[2.6rem] font-bold leading-[1.03] tracking-[-0.03em] sm:text-6xl lg:text-[4.25rem]"
      >
        Productos que la gente usa de verdad
      </h1>

      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-mist-300" style="--reveal-delay:90ms">
        TryFlama es una empresa sin fines de lucro de República Dominicana. Construimos
        webs, APIs de IA y herramientas para desarrolladores y usuarios. Sin límites
        artificiales.
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--reveal-delay:160ms">
        <a href="#contacto" class="btn-flame" data-open-tab="contacto">
          Únete a la comunidad
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="#productos" class="btn-glass" data-open-tab="productos">
          Ver nuestros productos
        </a>
      </div>

      <dl class="reveal mt-11 grid max-w-lg grid-cols-3 gap-4" style="--reveal-delay:230ms">
        {
          STAT_LINE.map((s) => (
            <div class="border-l border-white/12 pl-4 first:border-l-0 first:pl-0">
              <dt class="sr-only">{s.label}</dt>
              <dd>
                {s.icon ? (
                  <Icon name={s.icon} class="block h-8 w-8 sm:h-10 sm:w-10 text-flame-300" />
                ) : (
                  <span class="block font-display text-2xl font-bold text-white sm:text-3xl">
                    {s.value}
                  </span>
                )}
                <span class="mt-1 block text-xs font-medium text-mist-400">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Orbe de vidrio líquido -->
    <div class="orb-stage reveal" style="--reveal-delay:120ms">
      <div class="orb" aria-hidden="true">
        <span class="orb__ring orb__ring--3"></span>
        <span class="orb__ring orb__ring--2"></span>
        <span class="orb__ring orb__ring--1"></span>
        <span class="orb__core"></span>
        <span class="orb__gloss"></span>
        <span class="orb__embers" aria-hidden="true">
          <span class="ember"></span>
          <span class="ember"></span>
          <span class="ember"></span>
          <span class="ember"></span>
          <span class="ember"></span>
          <span class="ember"></span>
        </span>
      </div>

      <div class="float-card float-card--a">
        <span class="grid h-9 w-9 place-items-center rounded-[11px] border border-flame-300/30 bg-flame-500/15 text-flame-300">
          <Icon name="api" class="h-4 w-4" />
        </span>
        <span>
          <span class="block font-display text-base font-bold leading-none text-white">API ilimitada</span>
          <span class="mt-1 block text-[11px] font-medium text-mist-400">IA sin límites</span>
        </span>
      </div>

      <div class="float-card float-card--b">
        <span class="grid h-9 w-9 place-items-center rounded-[11px] border border-flame-300/30 bg-flame-500/15 text-flame-300">
          <Icon name="bot" class="h-4 w-4" />
        </span>
        <span>
          <span class="block font-display text-base font-bold leading-none text-white">Anna</span>
          <span class="mt-1 block text-[11px] font-medium text-mist-400">Bot de Discord</span>
        </span>
      </div>

      <div class="float-card float-card--c">
        <span class="grid h-9 w-9 place-items-center rounded-[11px] border border-flame-300/30 bg-flame-500/15 text-flame-300">
          <Icon name="shield" class="h-4 w-4" />
        </span>
        <span>
          <span class="block font-display text-base font-bold leading-none text-white">24/7</span>
          <span class="mt-1 block text-[11px] font-medium text-mist-400">Soporte real</span>
        </span>
      </div>
    </div>
  </div>
</section>
