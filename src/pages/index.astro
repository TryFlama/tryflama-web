---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import TabsSection from '../components/TabsSection.astro'
import { TRUSTPILOT_REVIEWS, fmtDate, type Review } from '../data/site'

const SCRAPE_DO_TOKEN = import.meta.env.SCRAPE_DO_TOKEN || ''
const FEATURE_ID = '0x8eaf89a36192c793:0x0b1a2a062496548d'

interface GoogleReview extends Review {}

const FALLBACK_GOOGLE: GoogleReview[] = [
  { name: 'joaquin jordan', stars: 5, date: '16 de agosto de 2026', text: 'nose pero es una empresa muy buena', photo: 'https://lh3.googleusercontent.com/a/ACg8ocJNuAUQt3HIRh8zjXC8bMmtoH53pR4Wa41RUtijvR2-TuWRBA=s120-c-rp-mo-br100', source: 'Google' },
  { name: 'zselever XD', stars: 5, date: '16 de agosto de 2026', text: 'buen selvicio', photo: 'https://lh3.googleusercontent.com/a-/ALV-UjXdaXb43KiNE00iI3QQGW30ZVNj0Gg29SXoU7PYoXw1QhAD8OU=s120-c-rp-mo-br100', source: 'Google' },
  { name: 'JhoX XIT', stars: 5, date: '15 de agosto de 2026', text: 'Son una excelente empresa y tiene mucha disciplina', photo: 'https://lh3.googleusercontent.com/a-/ALV-UjW6pGDcuerVIS4KZ_cdbZ44AeupmfP3oyA9ua3E7mM-4lFLqdiD=s120-c-rp-mo-br100', reply: 'Muchas Gracias por su opinión.', source: 'Google' },
  { name: 'Momentos de ale Wang', stars: 5, date: '11 de agosto de 2026', text: 'No sé pero sus productos son, 10/10 solo use los plis.', photo: 'https://lh3.googleusercontent.com/a/ACg8ocLKdoR3CD6BFWvSeyn6e1VzB3Os4drz5WxCvCSKwaRthRy9Bw=s120-c-rp-mo-br100', source: 'Google' },
  { name: 'Nord', stars: 5, date: '11 de agosto de 2026', text: 'Buen servicio', photo: 'https://lh3.googleusercontent.com/a-/ALV-UjVPegHXIzk_RA_SWDV2-VQzqxGkIEJinxjCcuv6cpTMV5DYjLcA=s120-c-rp-mo-br100', source: 'Google' },
]

let googleReviews: GoogleReview[] = FALLBACK_GOOGLE
let googleRating = 5
let googleCount = 5

if (SCRAPE_DO_TOKEN) {
  try {
    const url = `https://api.scrape.do/plugin/google/maps/reviews?token=${encodeURIComponent(SCRAPE_DO_TOKEN)}&data_id=${FEATURE_ID}&sort_by=newest&num=20`
    const res = await fetch(url, { headers: { accept: 'application/json' } })
    if (res.ok) {
      const data = await res.json()
      const items = data?.reviews
      if (Array.isArray(items) && items.length) {
        googleReviews = items.map((r: any) => ({
          name: r?.user?.name ?? 'Usuario de Google',
          stars: r?.rating ?? 5,
          date: fmtDate(r?.iso_date) || r?.date || '',
          text: r?.extracted_snippet?.original ?? r?.snippet ?? '',
          photo: r?.user?.thumbnail ?? '',
          reply: r?.response?.extracted_snippet?.original ?? r?.response?.snippet ?? null,
          source: 'Google',
        }))
        googleRating = data?.place_info?.rating ?? googleRating
        googleCount = data?.place_info?.reviews ?? googleCount
      }
    }
  } catch {}
}

const reviews: Review[] = [...googleReviews, ...TRUSTPILOT_REVIEWS]
const avg =
  reviews.some((r) => r.stars)
    ? reviews.reduce((acc, r) => acc + r.stars, 0) / reviews.length
    : 5
---

<Layout>
  <Hero />
  <TabsSection reviews={reviews} rating={Math.round(avg * 10) / 10} reviewCount={reviews.length} />
</Layout>
