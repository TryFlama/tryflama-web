  <script>
    const googleReviews = JSON.parse(document.getElementById('google-reviews-data')!.textContent || '[]');
    const reviews = [
      ...googleReviews,
      { name: 'MATEO LOPEZ ESTEBAN', country: 'MX', stars: 5, date: '14 de agosto de 2026', text: 'Los Femboys son de muy buena calidad' },
      { name: 'Cuenta RBD', country: 'PE', stars: 5, date: '12 de agosto de 2026', text: 'Vengo de parte de Haruuu, muy buena atención dan, muy recomendable' },
      { name: 'Xavier Alberto Ticona', country: 'BO', stars: 5, date: '11 de agosto de 2026', text: 'Recomendable :]' },
      { name: 'Principe Obreke', country: 'CL', stars: 5, date: '11 de agosto de 2026', text: 'Vengo de parte de Haruu' },
      { name: 'Efrain', country: 'AR', stars: 5, date: '10 de agosto de 2026', text: 'Hola, geo, cuando abres el host? XD' },
      { name: 'Traxet', country: 'EC', stars: 5, date: '6 de junio de 2026', text: 'Muy buen hosting de servidores, no hay lag y el ping es de lo mejor, 100% recomendado y si pueden hagan conocer este gran servicio de hosting (vengo de parte de haru)' },
      { name: 'Nord', country: 'FR', stars: 5, date: '12 de agosto de 2025', text: 'ñ??? POR QUE TE MIENTES, SI SABES QUE TE GUSTO' },
    ];

    function stars(n: number) {
      let s = '';
      for (let i = 0; i < 5; i++) {
        s += i < n
          ? '<svg class="h-4 w-4 text-flame-500" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z"/></svg>'
          : '<svg class="h-4 w-4 text-slate-700" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z"/></svg>';
      }
      return s;
    }

    const G_SVG = '<svg class="h-3.5 w-3.5" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';

    const grid = document.getElementById('reviews-grid');
    grid!.innerHTML = reviews.map(r => {
      const avatar = r.photo
        ? `<img src="${r.photo}" alt="${r.name}" loading="lazy" class="h-10 w-10 shrink-0 rounded-full object-cover">`
        : `<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[radial-gradient(circle_at_center,#ff3b57,#e6102f)] text-sm font-bold text-white">${r.name[0]}</span>`;
      const meta = r.source === 'Google'
        ? `${r.date}`
        : `${r.country} · ${r.date} · Trustpilot`;
      const badge = r.source === 'Google'
        ? `<span class="inline-flex items-center gap-1 rounded-md border border-white/10 bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">${G_SVG}Google</span>`
        : '';
      return `
      <article class="fade-up card-dark flex flex-col rounded-2xl p-7">
        <div class="flex items-start justify-between gap-2">
          <div class="flex items-center gap-1">${stars(r.stars)}</div>
          ${badge}
        </div>
        <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-300">"${r.text}"</p>
        ${r.reply ? `
        <div class="mt-4 rounded-xl border border-white/5 bg-ink-800 p-4">
          <p class="text-[11px] font-bold uppercase tracking-widest text-flame-400">Respuesta de TryFlama</p>
          <p class="mt-1.5 text-sm text-slate-300">${r.reply}</p>
        </div>` : ''}
        <div class="mt-6 flex items-center gap-3 border-t border-white/5 pt-5">
          ${avatar}
          <div>
            <p class="text-sm font-bold text-white">${r.name}</p>
            <p class="text-xs text-slate-500">${meta}</p>
          </div>
        </div>
      </article>
      `;
    }).join('');

    const menuBtn = document.getElementById('menu-btn');
    menuBtn?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });

    const sections = document.querySelectorAll<HTMLElement>('section[id]');
    const navLinks = document.querySelectorAll<HTMLElement>('.nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(s => {
        if (window.scrollY >= s.offsetTop - 140) current = s.id;
      });
      navLinks.forEach(l => {
        l.classList.toggle('text-white', l.getAttribute('href') === '#' + current);
      });
    }, { passive: true });

    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
  </script>
